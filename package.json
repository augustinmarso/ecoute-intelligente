{
  "name": "ecoute-intelligente",
  "version": "1.0.0",
  "description": "Apprendre l'anglais avec YouTube et Anki",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "app": "electron .",
    "dist": "electron-builder --win"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.marso.ecoute-intelligente",
    "productName": "Ecoute Intelligente",
    "npmRebuild": false,
    "files": [
      "server.js",
      "electron/**",
      "public/**",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
